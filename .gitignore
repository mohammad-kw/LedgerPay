# ============================================================================
# Root .gitignore for the LedgerPay project (backend + future frontend)
# ============================================================================

# ---- Secrets --------------------------------------------------------------
# PROJECT_SPEC.md Section 7: "All secrets (DB password, JWT secret,
# Razorpay keys, webhook secret) in environment variables — never
# committed to Git. Add a .env file to .gitignore." This is the single
# most important rule in this file - never remove these lines.
.env
.env.*
!.env.example

# ---- Backend: Maven / Java --------------------------------------------------
backend/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---- Frontend: Node / React (added ahead of time for Phase 1's frontend task) ----
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Vite dev cache (can appear at repo root or under frontend/) ----
.vite/
frontend/.vite/

# ---- IDE / editor files -----------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.iws

# ---- OS-generated files -------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Logs -------------------------------------------------------------------
*.log
logs/
