{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: mvn compile",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "compile"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "frontend: dev server",
      "type": "shell",
      "command": "node",
      "args": ["node_modules/vite/bin/vite.js"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(ready in|Local:).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
