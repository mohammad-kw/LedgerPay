# ============================================================================
# LedgerPay backend - SECRETS TEMPLATE
# ============================================================================
# HOW TO USE:
#   1. Copy this file to `.env` in the same folder:
#        Copy-Item backend\.env.example backend\.env
#   2. Fill in your REAL values in `.env` (never in this .example file).
#   3. Start the backend with the helper script (from the repo root):
#        .\run-backend.ps1
#
# `.env` is listed in .gitignore, so your real secrets are NEVER committed
# to git. This `.env.example` file is safe to commit because it only
# documents the variable NAMES, not their values.
#
# IMPORTANT: never paste the values below into any chat, screenshot, commit,
# or bug report. The key-secret and webhook-secret are bearer credentials -
# whoever holds them can act as your Razorpay account.
# ============================================================================

# ---- Database (MySQL) ------------------------------------------------------
DB_USERNAME=root
DB_PASSWORD=1234

# ---- JWT signing secret (optional locally) ---------------------------------
# Leave unset to use the local-dev fallback in application.properties.
# Set a real 32+ byte random value in any real deployment.
# JWT_SECRET=

# ---- Razorpay TEST-mode keys ----------------------------------------------
# Get these from: Razorpay Dashboard -> Settings -> API Keys -> Generate Test Key
#
# key-id  (rzp_test_...) is PUBLIC by design - it is sent to the browser so
#         Checkout can open. Safe to expose.
# key-secret is BACKEND-ONLY - it signs orders and must NEVER leave your
#         machine, be committed, or be shared. Treat it like a password.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here

# ---- Razorpay webhook signing secret ---------------------------------------
# You choose this yourself when creating a webhook in the Razorpay Dashboard
# (Settings -> Webhooks). Razorpay uses it to HMAC-sign every webhook it sends.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---- DEV-ONLY: mock top-up (Razorpay bypass) -------------------------------
# Set to true to enable POST /api/wallet/topup/mock, which instantly credits a
# wallet WITHOUT Razorpay - handy while your Razorpay account activation is
# pending. It reuses the real ledger + state-machine logic, but lets you mint
# money on demand, so NEVER enable it in a real deployment. Default: false.
MOCK_TOPUP_ENABLED=false

# ---- Admin bootstrap account (RBAC) ----------------------------------------
# On startup, AdminSeeder creates ONE user with role=ADMIN from these values
# if it doesn't already exist. There is NO "register as admin" API - the first
# admin must come from trusted server config like this. Leave blank and no
# admin is created. Log in normally at /login with these credentials; the
# frontend routes ADMIN users to the /admin dashboard.
ADMIN_EMAIL=admin@ledgerpay.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrator

# ---- CORS: allowed frontend origins ----------------------------------------
# Comma-separated list of browser origins allowed to call this API. Local dev
# uses the Vite proxy so this can stay unset (defaults to the Vite dev server).
# In production set this to your deployed frontend URL(s), e.g.
#   CORS_ALLOWED_ORIGINS=https://ledgerpay.vercel.app
# CORS_ALLOWED_ORIGINS=
